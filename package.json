{
  "name": "propel",
  "private": true,
  "version": "1.2.0",
  "description": "Premium Windows Optimization Suite",
  "author": {
    "name": "Propel",
    "email": "support@cleanmasterpro.in",
    "url": "https://cleanmasterpro.in"
  },
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:win": "electron-vite build && node scripts/generate-integrity-manifest.mjs && electron-builder --win",
    "preview": "electron-vite preview",
    "sourcemaps:upload": "node scripts/upload-sourcemaps.mjs",
    "generate:manifest": "node scripts/generate-integrity-manifest.mjs",
    "verify:integrity": "node scripts/verify-integrity.mjs",
    "build:signature": "node scripts/get-build-signature.mjs",
    "build:release": "electron-vite build && node scripts/generate-integrity-manifest.mjs && node scripts/upload-sourcemaps.mjs && electron-builder --win"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-progress": "^1.0.3",
    "@radix-ui/react-scroll-area": "^1.0.5",
    "@radix-ui/react-separator": "^1.0.3",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-switch": "^1.0.3",
    "@radix-ui/react-tabs": "^1.0.4",
    "@radix-ui/react-tooltip": "^1.0.7",
    "@sentry/electron": "^5.12.0",
    "@sentry/react": "^8.55.2",
    "@supabase/supabase-js": "^2.116.0",
    "axios": "^1.6.7",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "electron-updater": "^6.8.9",
    "framer-motion": "^11.0.6",
    "highlight.js": "^11.11.1",
    "lucide-react": "^0.344.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.22.2",
    "recharts": "^2.12.3",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "semver": "^7.8.5",
    "systeminformation": "^5.22.2",
    "tailwind-merge": "^2.2.1",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@types/node": "^20.11.19",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@types/semver": "^7.8.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "electron": "^29.1.0",
    "electron-builder": "^24.9.1",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.1.3"
  },
  "build": {
    "appId": "com.cleanmasterpro.desktop",
    "productName": "Propel",
    "copyright": "© Propel",
    "publish": [
      {
        "provider": "github",
        "owner": "pranavop45",
        "repo": "propel-releases"
      }
    ],
    "files": [
      "out/**/*",
      {
        "from": "electron/security",
        "to": "electron/security",
        "filter": [
          "integrity-manifest.json"
        ]
      }
    ],
    "extraResources": [
      {
        "from": "src/assets/icons/propel.ico",
        "to": "icon.ico"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/assets/icons/propel.ico",
      "executableName": "Propel",
      "publisherName": "Propel",
      "legalTrademarks": "Propel",
      "requestedExecutionLevel": "asInvoker",
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "src/assets/icons/propel.ico",
      "uninstallerIcon": "src/assets/icons/propel.ico",
      "installerHeaderIcon": "src/assets/icons/propel.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Propel",
      "displayLanguageSelector": false,
      "perMachine": false
    },
    "directories": {
      "output": "release",
      "buildResources": "resources"
    }
  }
}
