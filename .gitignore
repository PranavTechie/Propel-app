# ─────────────────────────────────────────────────────────────
# CleanMaster Pro — Electron App .gitignore
# ─────────────────────────────────────────────────────────────

# ── Secrets ───────────────────────────────────────────────────
.env
.env.*
.env.local
.env.development
.env.production
electron-builder.env
*.pem
*.key
*.crt
*.pfx
*.p12

# ── Build & packaging outputs ─────────────────────────────────
out/
dist/
release/
build/
dist-electron/
# ── Generated build artifacts (never commit — auto-generated each build) ──
electron/security/integrity-manifest.json

# ── Electron-specific packaging artifacts ─────────────────────
*.blockmap
*.asar
app.asar.unpacked/
*.snap
*.AppImage

# ── Node ──────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── TypeScript cache ──────────────────────────────────────────
*.tsbuildinfo
tsconfig.web.tsbuildinfo
tsc_output.txt

# ── Logs ──────────────────────────────────────────────────────
logs/
*.log

# ── OS artifacts ──────────────────────────────────────────────
.DS_Store
Thumbs.db
